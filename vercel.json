{
  "version": 2,
  "headers": [
    { "source": "/myfa.html", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" }] },
    { "source": "/myfa", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" }] }
  ],
  "redirects": [
    { "source": "/drop.html", "destination": "/api/drop.js", "permanent": false }
  ],
  "rewrites": [
    { "source": "/favicon.ico", "destination": "/favicon.svg" },
    { "source": "/api/admin-auth", "destination": "/api/admin-auth.js" },
    { "source": "/api/admin-gateway", "destination": "/api/admin-gateway.js" },
    { "source": "/api/admin/data", "destination": "/api/admin-gateway?target=data" },
    { "source": "/api/admin/config-update", "destination": "/api/admin-gateway?target=config-update" },
    { "source": "/api/admin/tasks", "destination": "/api/admin-gateway?target=tasks" },
    { "source": "/api/admin/promos", "destination": "/api/admin-gateway?target=promos" },
    { "source": "/api/admin/user-action", "destination": "/api/admin-gateway?target=user-action" },
    { "source": "/api/admin/withdrawals", "destination": "/api/admin-gateway?target=withdrawals" },
    { "source": "/api/admin/channel/post", "destination": "/api/admin-gateway?target=channel%2Fpost" },
    { "source": "/api/admin/verifications/action", "destination": "/api/admin-gateway?target=verifications%2Faction" },
    { "source": "/api/admin/test-channel", "destination": "/api/admin-gateway?target=test-channel" },
    { "source": "/api/admin/invoice", "destination": "/api/admin-gateway?target=invoice" },
    { "source": "/api/admin/backup", "destination": "/api/admin-gateway?target=backup" },
    { "source": "/api/admin/wipe", "destination": "/api/admin-gateway?target=wipe" },
    { "source": "/api/admin/css-inject", "destination": "/api/admin-gateway?target=css-inject" },
    { "source": "/api/admin/broadcast", "destination": "/api/admin-gateway?target=broadcast" },
    { "source": "/api/admin/logs", "destination": "/api/admin-gateway?target=logs" },
    { "source": "/api/ads", "destination": "/api/ads.js" },
    { "source": "/api/claim-promo", "destination": "/api/claim-promo.js" },
    { "source": "/api/campaign-manager/campaigns/:id/action", "destination": "/api/campaign-manager-action.js?id=:id" },
    { "source": "/myfa.html", "destination": "/api/admin-shell.js" },
    { "source": "/myfa", "destination": "/api/admin-shell.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
