{
  "version": 2,
  "redirects": [
    { "source": "/drop.html", "destination": "/api/drop.js", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/ads", "destination": "/api/ads.js" },
    { "source": "/api/admin/promos", "destination": "/api/admin-promos.js" },
    { "source": "/api/claim-promo", "destination": "/api/claim-promo.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/myfa", "destination": "/public/myfa.html" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
